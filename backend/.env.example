# Servidor
PORT=8080

# Banco (docker-compose já provê este host/credenciais)
DATABASE_URL=postgres://zapgov:zapgov@localhost:5432/zapgov?sslmode=disable

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=        # ID do número (Gerenciador da Meta)
WHATSAPP_WABA_ID=                # WhatsApp Business Account ID (para sincronizar templates)
WHATSAPP_TOKEN=                  # token de acesso permanente (System User)
WHATSAPP_APP_SECRET=             # App Secret — usado para validar o HMAC do webhook
WHATSAPP_API_VERSION=v21.0

# Webhook — token arbitrário que você define e também cadastra no painel da Meta
WEBHOOK_VERIFY_TOKEN=troque-por-uma-string-secreta

# Segredo para assinar os JWT de login (troque por uma string longa e aleatória)
JWT_SECRET=troque-por-uma-string-longa-aleatoria

# Redis (fila de disparos via Asynq)
REDIS_ADDR=localhost:6379

# Observabilidade
LOG_LEVEL=info          # debug | info | warn | error
APP_ENV=dev             # dev | staging | production
SENTRY_DSN=             # vazio = Sentry desligado

# Administrador inicial: configure antes da primeira subida (12–72 bytes).
SEED_ADMIN_PASSWORD=
# 64 caracteres hexadecimais: openssl rand -hex 32 (guarde com backup).
META_CREDENTIALS_KEY=

# Gateway WhatsApp <-> SIGE (relay bidirecional de chamados). Ver deploy/GATEWAY.md.
# Vazio = desligado (o tenant segue no motor de fluxo normal).
GATEWAY_TENANT_ID=              # tenant cujo número usa o gateway (ex.: 2 = T.I.)
GATEWAY_INBOUND_API_KEY=        # X-API-Key que o SIGE usa ao chamar /v1/* (= ZAPGOV_API_KEY no SIGE)
SIGE_BASE_URL=                  # base do SIGE (ex.: https://sige.exemplo.gov.br)
SIGE_API_KEY=                   # X-API-Key que o ZapGov envia ao SIGE (= INTEGRACAO_API_KEY no SIGE)
SIGE_HMAC_SECRET=               # assina os webhooks ZapGov->SIGE (= INTEGRACAO_HMAC_SECRET no SIGE)
