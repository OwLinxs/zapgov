# Ambiente de DESENVOLVIMENTO local. Copie para backend/.env.dev e ajuste.
#   cp backend/.env.dev.example backend/.env.dev
# Carregue antes de rodar:  set -a; source backend/.env.dev; set +a
#
# NUNCA aponte para o banco ou o número de WhatsApp de PRODUÇÃO.

PORT=8080

# Banco/Redis do docker-compose.dev.yml (portas 5433/6380 no host).
DATABASE_URL=postgres://zapgov:dev@localhost:5433/zapgov_dev?sslmode=disable
REDIS_ADDR=localhost:6380

# ---- Meta WhatsApp (AMBIENTE DE TESTE) ----
# IMPORTANTE: crie um App SEPARADO na Meta para dev (ou use o número de teste do
# app). NÃO reaproveite o número oficial — mudar o webhook dele derruba a prod.
# Painel Meta > WhatsApp > API Setup tem um "número de teste" grátis que envia
# para até 5 destinatários cadastrados — ideal para dev.
WHATSAPP_PHONE_NUMBER_ID=COLE_O_ID_DO_NUMERO_DE_TESTE
WHATSAPP_WABA_ID=COLE_O_WABA_DE_TESTE
WHATSAPP_TOKEN=COLE_O_TOKEN_DE_TESTE
WHATSAPP_APP_SECRET=COLE_O_APP_SECRET_DO_APP_DE_DEV
WHATSAPP_API_VERSION=v21.0

# Token que você inventa e cadastra no webhook do app de DEV (não o da prod).
WEBHOOK_VERIFY_TOKEN=dev-verify-token-troque-isto

# Segredo JWT — qualquer string longa; pode ser diferente da prod.
JWT_SECRET=dev-jwt-secret-troque-por-algo-aleatorio-longo

# Origem do front local (CORS).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=debug
APP_ENV=development
SENTRY_DSN=
