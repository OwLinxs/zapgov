# Versiona backend/, web/, deploy/ e os composes. Resto fica de fora.
/*
!/backend/
!/web/
!/deploy/
!/docker-compose.prod.yml
!/docker-compose.dev.yml
!/Makefile
!/.gitignore
!/LICENSE.md
!/.github/

# Segredos — nunca versionar (mesmo dentro das pastas acima)
backend/.env
backend/.env.dev
*.env.local

# Build / deps / backups
node_modules/
web/.next/
web/out/
*.sql.gz
.DS_Store
*.log
